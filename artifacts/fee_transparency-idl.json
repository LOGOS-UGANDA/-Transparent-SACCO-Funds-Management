          { "name": "reference_number", "type": "string" },
          { "name": "amount", "type": "u128" },
          { "name": "status", "type": { "defined": "FeeStatus" } },
          { "name": "allocations", "type": { "vec": { "defined": "FeeAllocation" } } }
        ]
      }
    },
    {
