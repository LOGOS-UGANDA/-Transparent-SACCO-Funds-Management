# ── Logos Blockchain Configuration ──

# RPC URL for the Logos blockchain
LOGOS_RPC_URL=https://rpc.logos.co
LOGOS_CHAIN_ID=0

# ── Frontend (Vite env vars must start with VITE_) ──

# Deployed contract address (set after running deploy script)
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Network the frontend should target (hex chain ID)
VITE_CHAIN_ID=0x7A69
VITE_CHAIN_NAME=Logos Blockchain
VITE_RPC_URL=http://127.0.0.1:8545

# ── Deployer (NEVER commit this) ──
PRIVATE_KEY=
